{
  "name": "scratch-obfuscator",
  "version": "0.3.0",
  "description": "Deterministic Scratch 3 project obfuscator",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/priospire/scratch-obfuscator.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {},
  "bin": {
    "scratch-obfuscator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "QA_SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "qa": "npm run typecheck && npm run lint && npm run audit:runtime && npm run test:coverage && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scratch/scratch-vm": "15.1.0",
    "@types/node": "22.20.1",
    "@types/yauzl": "2.10.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.0.1",
    "fast-check": "4.9.0",
    "scratch-parser": "6.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
