{
  "name": "scratch-obfuscator",
  "version": "0.7.0",
  "description": "Deterministic Scratch 3 project obfuscator",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priospire/scratch-obfuscator.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {},
  "bin": {
    "scratch-obfuscator": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "audit:dependencies": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "check:dependency-policy": "node scripts/check-dependency-policy.mjs package-lock.json qa/gui/package-lock.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:release-coverage": "node scripts/check-release-coverage.mjs",
    "qa": "npm run typecheck && npm run lint && npm run audit:runtime && npm run audit:dependencies && npm run audit:signatures && npm run check:dependency-policy && npm run test:coverage && npm run check:release-coverage && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scratch/scratch-render": "file:qa/shims/scratch-render",
    "@scratch/scratch-vm": "15.1.0",
    "@types/node": "22.20.1",
    "@types/yauzl": "2.10.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "scratch-audio": "file:qa/shims/scratch-audio",
    "scratch-parser": "6.0.1",
    "text-encoding": "file:qa/shims/text-encoding",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@scratch/scratch-render": "$@scratch/scratch-render",
    "immutable": "4.3.9",
    "scratch-audio": "$scratch-audio",
    "uuid": "11.1.1"
  }
}
